{
  "manifest_version": 2,
  "name": "Reading Timer",
  "version": "0.9.1",
  "description": "Estimates reading time (Manifest V2 example: background page, getBackgroundPage, ports, localStorage).",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "browser_action": { "default_popup": "popup.html", "default_title": "Reading time", "default_icon": "icons/icon32.png" },
  "background": { "scripts": ["lib/format.js", "background.js"], "persistent": true },
  "permissions": ["storage", "tabs", "contextMenus", "<all_urls>"],
  "content_scripts": [{ "matches": ["http://*/*", "https://*/*", "file:///*"], "js": ["lib/mini-dollar.js", "content.js"], "run_at": "document_end" }]
}
